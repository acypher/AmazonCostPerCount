{
  "manifest_version": 3,
  "name": "Amazon Results Sort by CostPerCount",
  "short_name": "CostPerCount",
  "version": "1.0.13",
  "description": "Sorts Amazon search results by price per ounce or count and flags misleading unit prices.",
  "browser_specific_settings": {
    "gecko": {
      "id": "amazon-results-costpercount@acypher.com",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/s?*",
        "https://www.amazon.com/s/*"
      ],
      "js": [
        "src/unitprice.js",
        "src/comparison.js",
        "src/photo.js",
        "src/photo-client.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://m.media-amazon.com/*",
    "https://images-na.ssl-images-amazon.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ocr/host.html"
      ],
      "matches": [
        "https://www.amazon.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self' https://m.media-amazon.com https://images-na.ssl-images-amazon.com"
  }
}
